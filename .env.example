# Public site URL used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.oddsbridge.com

# Optional: The Odds API key (https://the-odds-api.com). When set, odds pages use live
# prices for supported US/UK/EU bookmakers. When unset, deterministic sample odds are shown.
ODDS_API_KEY=

# Optional: comma-separated The Odds API regions to request (uk,eu,us,us2,au).
ODDS_API_REGIONS=uk,eu,us

# Optional: enable experimental live booking-code adapters (see src/lib/converter/adapters).
# These call third-party bookmaker endpoints that may change without notice.
ENABLE_LIVE_ADAPTERS=false
